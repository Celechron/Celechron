// Shared version settings for the satellite targets:
// WidgetExtensions, CelechronWatch, WatchWidgetExtensions.
//
// Celechron derives its version from Generated.xcconfig, which Flutter rewrites
// from pubspec.yaml on every `flutter pub get` / build. Pointing the embedded
// bundles at the same source keeps them in lockstep: App Store validation
// rejects an .appex or watch app whose CFBundleShortVersionString disagrees
// with its host app, and hand-bumping each target is what let them drift to
// 1.0 while the host was on 1.3.0.
//
// Bump pubspec.yaml — nothing here needs editing.

// Defaults, in case Generated.xcconfig has not been produced yet. It is
// gitignored, so it is absent on a fresh clone until Flutter regenerates it.
// The optional include below overrides these whenever the file does exist.
FLUTTER_BUILD_NAME = 1.0.0
FLUTTER_BUILD_NUMBER = 1

#include? "../Flutter/Generated.xcconfig"

MARKETING_VERSION = $(FLUTTER_BUILD_NAME)
CURRENT_PROJECT_VERSION = $(FLUTTER_BUILD_NUMBER)
